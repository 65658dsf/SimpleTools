# Release/update configuration. Never commit real signing keys.
SIMPLETEOOLS_UPDATE_OWNER=65658dsf
SIMPLETEOOLS_UPDATE_REPOSITORY=SimpleTools
# Base64-encoded raw Ed25519 public key used by the updater.
SIMPLETEOOLS_UPDATE_PUBLIC_KEY=
# Base64-encoded PEM Ed25519 private key (CI only; never ship this value).
SIMPLETEOOLS_UPDATE_PRIVATE_KEY_BASE64=
# Base64-encoded PFX/P12 signing certificates (CI only).
SIMPLETEOOLS_WINDOWS_CERTIFICATE_BASE64=
SIMPLETEOOLS_WINDOWS_CERTIFICATE_PASSWORD=
SIMPLETEOOLS_WINDOWS_TIMESTAMP_URL=https://timestamp.sectigo.com
SIMPLETEOOLS_MACOS_CERTIFICATE_BASE64=
SIMPLETEOOLS_MACOS_CERTIFICATE_PASSWORD=
SIMPLETEOOLS_MACOS_SIGNING_IDENTITY=
SIMPLETEOOLS_MACOS_TEAM_ID=
SIMPLETEOOLS_MACOS_NOTARY_PROFILE=
SIMPLETEOOLS_MACOS_NOTARY_APPLE_ID=
SIMPLETEOOLS_MACOS_NOTARY_PASSWORD=
