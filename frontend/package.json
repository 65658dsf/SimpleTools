{
  "name": "simpletools-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "jsqr": "1.4.0",
    "lucide-vue-next": "0.468.0",
    "pinia": "2.3.0",
    "qrcode": "1.5.4",
    "vue": "3.5.13",
    "vue-i18n": "10.0.5",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/qrcode": "1.5.6",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "shadcn-vue": "^2.8.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.69.0",
    "vite": "6.1.0",
    "vitest": "3.0.5",
    "vue-tsc": "2.2.0"
  }
}
